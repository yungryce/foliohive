            "appInsightsName": {
              "type": "string",
              "metadata": {
                "description": "Application Insights resource name for connection string resolution"
              }
            },
            "logAnalyticsWorkspaceId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Log Analytics Workspace resource ID for diagnostics"
              }
            },
            "corsAllowedOrigins": {
              "type": "array",
              "defaultValue": [],
              "metadata": {
                "description": "Additional CORS origins (e.g. static web app hostname)"
              }
            },
            "flexPlanName": {
              "type": "string",
              "defaultValue": "[format('{0}-flex-plan', parameters('functionAppName'))]",
              "metadata": {
                "description": "Name of the Flex Consumption plan created for this app"
              }
            },
            "flexMaximumInstanceCount": {
              "type": "int",
              "defaultValue": 100,
              "minValue": 1,
              "maxValue": 1000,
              "metadata": {
                "description": "Maximum number of Flex instances allowed for this app"
              }
            },
            "flexInstanceMemoryMb": {
              "type": "int",
              "defaultValue": 2048,
              "minValue": 512,
              "maxValue": 4096,
              "metadata": {
                "description": "Memory per Flex instance in MB (512 MB increments)"
              }
            },
            "httpPerInstanceConcurrency": {
              "type": "int",
              "defaultValue": 20,
              "minValue": 1,
              "maxValue": 100,
              "metadata": {
                "description": "HTTP concurrency per instance for Flex Consumption"
              }
            },
            "flexAlwaysReadyInstanceCount": {
              "type": "int",
              "defaultValue": 0,
              "minValue": 0,
              "maxValue": 10,
              "metadata": {
                "description": "Always Ready instance count; set to >0 to keep warm workers available"
              }
            }
          },
          "resources": {
            "appInsightsRef": {
              "existing": true,
              "type": "Microsoft.Insights/components",
              "apiVersion": "2020-02-02",
              "name": "[parameters('appInsightsName')]"
            },
            "flexPlan": {
              "type": "Microsoft.Web/serverfarms",
              "apiVersion": "2024-11-01",
              "name": "[parameters('flexPlanName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "functionapp,linux",
              "sku": {
                "name": "FC1",
                "tier": "FlexConsumption"
              },
              "properties": {
                "maximumElasticWorkerCount": "[parameters('flexMaximumInstanceCount')]",
                "perSiteScaling": false,
                "reserved": true,
                "targetWorkerCount": "[parameters('flexAlwaysReadyInstanceCount')]"
              }
            },
            "functionApp": {
              "type": "Microsoft.Web/sites",
              "apiVersion": "2025-03-01",
              "name": "[parameters('functionAppName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "functionapp,linux",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', parameters('uamiId'))]": {}
                }
              },
              "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('flexPlanName'))]",
                "httpsOnly": true,
                "outboundVnetRouting": {
                  "applicationTraffic": true
                },
                "siteConfig": {
                  "alwaysOn": false,
                  "minTlsVersion": "1.2",
                  "ftpsState": "Disabled",
                  "scmType": "None",
                  "cors": {
                    "allowedOrigins": "[parameters('corsAllowedOrigins')]",
                    "supportCredentials": false
                  }
                },
                "functionAppConfig": {
                  "deployment": {
                    "storage": {
                      "type": "blobContainer",
                      "value": "[format('https://{0}.blob.{1}/function-deployments', parameters('storageAccountName'), environment().suffixes.storage)]",
                      "authentication": {
                        "type": "UserAssignedIdentity",
                        "userAssignedIdentityResourceId": "[parameters('uamiId')]"
                      }
                    }
                  },
                  "runtime": {
                    "name": "python",
                    "version": "3.13"
                  },
                  "scaleAndConcurrency": {
                    "instanceMemoryMB": "[parameters('flexInstanceMemoryMb')]",
                    "maximumInstanceCount": "[parameters('flexMaximumInstanceCount')]",
                    "triggers": {
                      "http": {
                        "perInstanceConcurrency": "[parameters('httpPerInstanceConcurrency')]"
                      }
                    }
                  }
                }
              },
              "dependsOn": [
                "flexPlan"
              ]
            },
            "functionAppVnetIntegration": {
              "type": "Microsoft.Web/sites/networkConfig",
              "apiVersion": "2024-11-01",
              "name": "[format('{0}/{1}', parameters('functionAppName'), 'virtualNetwork')]",
              "properties": {
                "subnetResourceId": "[parameters('functionsSubnetId')]",
                "swiftSupported": true
              },
              "dependsOn": [
                "functionApp",
                "functionAppAppSettings"
              ]
            },
            "functionAppDiagnostics": {
              "condition": "[not(empty(parameters('logAnalyticsWorkspaceId')))]",
              "type": "Microsoft.Insights/diagnosticSettings",
              "apiVersion": "2021-05-01-preview",
              "scope": "[format('Microsoft.Web/sites/{0}', parameters('functionAppName'))]",
              "name": "functionapp-diagnostics",
              "properties": {
                "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
                "logs": [
                  {
                    "categoryGroup": "allLogs",
                    "enabled": true
                  }
                ],
                "metrics": [
                  {
                    "category": "AllMetrics",
                    "enabled": true
                  }
                ]
              },
              "dependsOn": [
                "functionApp"
              ]
            },
            "functionAppAppSettings": {
              "type": "Microsoft.Web/sites/config",
              "apiVersion": "2024-11-01",
              "name": "[format('{0}/{1}', parameters('functionAppName'), 'appsettings')]",
              "properties": {
                "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference('appInsightsRef').ConnectionString]",
                "APPLICATIONINSIGHTS_AUTHENTICATION_STRING": "[format('ClientId={0};Authorization=AAD', parameters('uamiClientId'))]",
                "APPINSIGHTS_INSTRUMENTATIONKEY": "[reference('appInsightsRef').InstrumentationKey]",
                "APPLICATIONINSIGHTS_ROLE_NAME": "[parameters('functionAppName')]",
                "AzureWebJobsStorage__credential": "managedidentity",
                "AzureWebJobsStorage__blobServiceUri": "[format('https://{0}.blob.{1}', parameters('storageAccountName'), environment().suffixes.storage)]",
                "AzureWebJobsStorage__queueServiceUri": "[format('https://{0}.queue.{1}', parameters('storageAccountName'), environment().suffixes.storage)]",
                "AzureWebJobsStorage__tableServiceUri": "[format('https://{0}.table.{1}', parameters('storageAccountName'), environment().suffixes.storage)]",
                "AzureWebJobsStorage__ClientId": "[parameters('uamiClientId')]",
                "AzureWebJobsStorage__accountName": "[parameters('storageAccountName')]",
                "AZURE_CLIENT_ID": "[parameters('uamiClientId')]",
                "ENABLE_CONFIG_DISCOVERY_GRAPHQL": "true"
              },
              "dependsOn": [
                "appInsightsRef",
                "functionApp"
              ]
            }
          },
          "outputs": {
            "functionAppId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
            },
            "functionAppName": {
              "type": "string",
              "value": "[parameters('functionAppName')]"
            },
            "functionAppDefaultHostname": {
              "type": "string",
              "value": "[reference('functionApp').defaultHostName]"
            },
            "flexPlanId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Web/serverfarms', parameters('flexPlanName'))]"
            },
            "flexPlanName": {
              "type": "string",
              "value": "[parameters('flexPlanName')]"
