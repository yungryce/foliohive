  "outputs": {
    "functionAppId": {
      "type": "string",
      "value": "[reference('functionApp').outputs.functionAppId.value]"
    },
    "functionAppName": {
      "type": "string",
      "value": "[reference('functionApp').outputs.functionAppName.value]"
    },
    "functionAppDefaultHostname": {
      "type": "string",
      "value": "[reference('functionApp').outputs.functionAppDefaultHostname.value]"
